---
import { copy, localizePath, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = copy[locale];
const otherLocale = locale === 'en' ? 'pt-BR' : 'en';
const nav = [
  { href: `/${locale}/`, label: t.nav.home },
  { href: `/${locale}/work/`, label: t.nav.work },
  { href: `/${locale}/play/`, label: t.nav.play },
  { href: `/${locale}/about/`, label: t.nav.about },
];
---

<header class="site-header">
  <a class="brand" href={`/${locale}/`}>
    <span class="brand-mark" aria-hidden="true">FA</span>
    <span class="brand-copy">Fernando<br /><em>creative technologist</em></span>
  </a>
  <nav aria-label="Primary navigation">
    <ul class="nav-list">
      {nav.map((item) => (
        <li>
          <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <a class="language-switch" href={localizePath(pathname, otherLocale)} lang={otherLocale} data-analytics="locale_change">
    <span>{t.languageCode}</span>
    <span class="sr-only">{t.language}</span>
  </a>
</header>
