{
  "name": "fernando-playable-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:test": "node scripts/serve-preview.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "verify": "npm run check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "phaser": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-react-hooks": "latest",
    "jsdom": "^26.1.0",
    "prettier": "latest",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "^3.2.0"
  }
}
